<Window x:Class="App_Escritorio.VentanaMostrarProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Escritorio"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="Informacion del Producto" Height="450" Width="500">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF00BEFF"/>
                <GradientStop Color="White" Offset="0.997"/>
                <GradientStop Color="White" Offset="0.449"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Nombre" HorizontalAlignment="Left" Margin="42,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="142" FontSize="16" FontFamily="Franklin Gothic Demi"/>
        <Label x:Name="label_name" HorizontalAlignment="Left" Margin="250,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="142" Background="#FF82E2D4" Foreground="#FF020202" Height="26" FontSize="14" FontFamily="Arial Rounded MT Bold"/>
        <Label Content="Precio" HorizontalAlignment="Left" Margin="42,0,0,0" Grid.Row="2" VerticalAlignment="Center" Width="142" FontSize="16" FontFamily="Franklin Gothic Demi"/>
        <Label x:Name="label_price"  HorizontalAlignment="Left" Margin="250,15,0,0" Grid.Row="2" VerticalAlignment="Top" Width="142" Background="#FF82E2D4" Foreground="#FF020202" Height="26" FontFamily="Arial Rounded MT Bold" FontSize="14"/>
        <Label Content="Cantidad" HorizontalAlignment="Left" Margin="42,0,0,0" Grid.Row="3" VerticalAlignment="Center" Width="142" FontSize="16" FontFamily="Franklin Gothic Demi" RenderTransformOrigin="0.489,1.351"/>
        <Label x:Name="label_quantity"  HorizontalAlignment="Left" Margin="250,0,0,0" Grid.Row="3" VerticalAlignment="Center" Width="142" Background="#FF82E2D4" Foreground="#FF020202" Height="26" FontFamily="Arial Rounded MT Bold" FontSize="14"/>
        <Label Content="Imagen" HorizontalAlignment="Left" Margin="42,0,0,0" Grid.Row="4" VerticalAlignment="Center" Width="142" FontSize="16" FontFamily="Franklin Gothic Demi"/>
        <Button Content="Eliminar" HorizontalAlignment="Center" Grid.Row="8" VerticalAlignment="Center" Width="124" Height="34" Click="button_deleteProduct">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFA6E363" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Image x:Name="image_icon" HorizontalAlignment="Left" Height="174" Margin="199,10,0,0" Grid.RowSpan="4" Grid.Row="4" VerticalAlignment="Top" Width="237" OpacityMask="#FFE32C2C"/>

    </Grid>
</Window>
