<UserControl x:Class="App_Escritorio.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Escritorio"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Height="Auto" Width="Auto" >
        <!--Title="DashboardClientes"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Height="201" Width="386">-->

    <Grid x:Name="MainGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>

        </Grid.RowDefinitions>

        <!--Tabla que muestra los datos de los clientes-->
        <DataGrid x:Name="Tabla" AutoGenerateColumns="True" Grid.Row="0" Grid.ColumnSpan="2" ColumnWidth="*">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <!-- color del borde -->
                    <Setter Property="BorderBrush" Value="Black"/>
                    <!-- grosor del borde: derecha e inferior -->
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Margin" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DDEEFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <StackPanel x:Name="PanelTabla2" Grid.Row="1" Margin="5" Visibility="Collapsed">
            <Label x:Name="TituloTabla2" Content="Productos Mas Vendidos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <DataGrid x:Name="Tabla2" MaxHeight="200" AutoGenerateColumns="True" Grid.Row="1" Grid.ColumnSpan="2" ColumnWidth="*">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <!-- color del borde -->
                        <Setter Property="BorderBrush" Value="Black"/>
                        <!-- grosor del borde: derecha e inferior -->
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>

                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Margin" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDEEFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <Label x:Name="TituloTabla3" Content="Datos Generales de las Ventas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <DataGrid x:Name="Tabla3" MaxHeight="200" AutoGenerateColumns="True" Grid.Row="1" Grid.ColumnSpan="2" ColumnWidth="*">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <!-- color del borde -->
                        <Setter Property="BorderBrush" Value="Black"/>
                        <!-- grosor del borde: derecha e inferior -->
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>

                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Margin" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDEEFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </StackPanel>
        
        <!--Grafica de barras-->
        <lvc:CartesianChart Name="GraficaBarras" Series="{Binding SeriesCollectionBars}" Grid.Row="1" Visibility="Collapsed">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="" Labels="{Binding Labels}"></lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <!-- Eje Y -->
                <lvc:Axis Title="" LabelFormatter="{Binding Formatter}"></lvc:Axis>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!--Grafica de pie-->
        <lvc:PieChart Series="{Binding SeriesCollectionPie}" Grid.Row="1" Grid.Column="2">
            <lvc:PieChart.LegendLocation>Top</lvc:PieChart.LegendLocation>
        </lvc:PieChart>
    </Grid>
</UserControl>