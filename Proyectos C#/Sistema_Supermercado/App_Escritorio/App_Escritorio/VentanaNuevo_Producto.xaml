<Window x:Class="App_Escritorio.VentanaNuevo_Producto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Escritorio"
        mc:Ignorable="d"
        Title="Producto" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF00BEFF"/>
                <GradientStop Color="White" Offset="0.997"/>
                <GradientStop Color="White" Offset="0.449"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock  HorizontalAlignment="Center"  Grid.Row="1" TextWrapping="Wrap" Text="Nombre" VerticalAlignment="Center"  Height="33"  Width="140" FontFamily="Arial Rounded MT Bold" FontSize="18"></TextBlock>
        <TextBlock  HorizontalAlignment="Center"  Grid.Row="2" TextWrapping="Wrap"  VerticalAlignment="Center"  Height="33"  Width="140" FontFamily="Arial Rounded MT Bold" FontSize="18"><Run Language="es-gt" Text="Precio"/></TextBlock>

        <TextBlock  HorizontalAlignment="Center"  Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center"  Height="33"  Width="140" FontFamily="Arial Rounded MT Bold" FontSize="18"><Run Language="es-gt" Text="Cantidad"/></TextBlock>
        <TextBlock  HorizontalAlignment="Center"  Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center"  Height="33"  Width="140" FontFamily="Arial Rounded MT Bold" FontSize="18"><Run Language="es-gt" Text="Imagen"/></TextBlock>

        <TextBox x:Name="txtbox_name" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap"  VerticalContentAlignment="Center" VerticalAlignment="Center" Width="281" Height="33" FontFamily="Arial Rounded MT Bold" FontSize="16"/>
        <TextBox x:Name="txtbox_price" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap"  VerticalContentAlignment="Center" VerticalAlignment="Center" Width="281" Height="33" FontFamily="Arial Rounded MT Bold" FontSize="16"/>
        <TextBox x:Name="txtbox_quantity" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="3" TextWrapping="Wrap"  VerticalContentAlignment="Center" VerticalAlignment="Center" Width="281" Height="33" FontFamily="Arial Rounded MT Bold" FontSize="16"/>
        <Button Content="Guardar" HorizontalAlignment="Center"  Grid.Row="6" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="118" Height="42" Foreground="White" FontSize="16" FontWeight="Bold" BorderBrush="Black" Click="button_save">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF00DAFF"/>
                    <GradientStop Color="White" Offset="1"/>
                    <GradientStop Color="#FF1DB7D1" Offset="0.497"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button Grid.Column="1" Content="Seleccionar" HorizontalAlignment="Left" Grid.Row="4" VerticalAlignment="Center" Width="281" Height="33" FontSize="18" FontWeight="Bold" FontFamily="Sitka Small Semibold" Click="Button_Select">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF48CC80"/>
                    <GradientStop Color="White" Offset="1"/>
                    <GradientStop Color="#FF50AC77" Offset="0.495"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>
