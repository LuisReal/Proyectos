<Window x:Class="App_Escritorio.VentanaNueva_Venta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Escritorio"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Height="650" Width="700"
        Title="Facturacion">

    <Grid >
        <!-- <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF03BBFA"/>
                <GradientStop Color="White" Offset="0.997"/>
                <GradientStop Color="White" Offset="0.489"/>
            </LinearGradientBrush>
        </Grid.Background>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock    TextWrapping="Wrap"  VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" Height="33"  Width="100" FontFamily="Arial Rounded MT Bold" FontSize="18" Margin="10,0,0,0" Grid.Column="1"><Run Text="Cantidad"/><Run Language="es-gt" Text=":"/></TextBlock>

        <TextBlock  HorizontalAlignment="Left"  Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center"  Height="33"  Width="100" FontFamily="Arial Rounded MT Bold" FontSize="18" RenderTransformOrigin="0.479,0.269" Margin="27,0,0,0"><Run Text="Producto"/><Run Language="es-gt" Text=":"/></TextBlock>
        <TextBlock  HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top"  Height="33"  Width="80" FontFamily="Arial Rounded MT Bold" FontSize="18" Margin="27,66,0,0" Grid.RowSpan="2"><Run Language="es-gt" Text="Nombre:"/></TextBlock>
        <TextBox x:Name="txtbox_amount" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap"  VerticalContentAlignment="Center" VerticalAlignment="Center" Width="141" Height="33" FontFamily="Arial Rounded MT Bold" FontSize="16" Margin="140,0,0,0"/>
        <TextBox x:Name="txtbox_nit" Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap"  VerticalContentAlignment="Center" VerticalAlignment="Top" Width="175" Height="33" FontFamily="Arial Rounded MT Bold" FontSize="16" Margin="140,66,0,0" Grid.RowSpan="2"/>
        <Button Content="Agregar" HorizontalAlignment="Left"  Grid.Row="3" VerticalAlignment="Center" Width="144" Height="42" Foreground="White" FontSize="16" FontWeight="Bold" BorderBrush="Black" Click="button_add" Grid.Column="1" Margin="175,0,0,0">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF00DAFF"/>
                    <GradientStop Color="#FF1DB7D1" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <ComboBox x:Name="txt_select_product" Text="Elige una opcion" IsEditable="True" VerticalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" Width="208" Height="33" BorderBrush="#FF191717" Background="#FFDD0000" FontFamily="Arial Rounded MT Bold" FontSize="16" Margin="132,0,0,0"/>
        <DataGrid x:Name="TablaAgregados" AutoGenerateColumns="True" Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="3" ColumnWidth="*" Margin="10,0,10,83">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <!-- color del borde -->
                    <Setter Property="BorderBrush" Value="Black"/>
                    <!-- grosor del borde: derecha e inferior -->
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>

                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Margin" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DDEEFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <TextBlock x:Name="titulo_totalventa"  HorizontalAlignment="Left"  Grid.Row="6" TextWrapping="Wrap"  VerticalAlignment="Center"  Height="33"  Width="98" FontFamily="Arial Rounded MT Bold" FontSize="18" Grid.Column="0" Margin="252,0,0,0"><Run Language="es-gt" Text="Total:"/></TextBlock>

        <TextBlock x:Name="label_mostrar_total"  HorizontalAlignment="Left"  Grid.Row="6" TextWrapping="Wrap"  VerticalAlignment="Center"  Height="33"  Width="110" FontFamily="Arial Rounded MT Bold" FontSize="18" Grid.Column="1" Margin="5,0,0,0"><Run Language="es-gt" Text="0.00"/></TextBlock>
        <Border BorderBrush="Black" BorderThickness="0.5" Grid.ColumnSpan="2" Margin="10,39,10,42" Grid.RowSpan="2"/>
        <TextBlock  HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top"  Height="33"  Width="68" FontFamily="Arial Rounded MT Bold" FontSize="18" Margin="10,66,0,0" Grid.Column="1" Grid.RowSpan="2"><Run Text="Nit"/><Run Language="es-gt" Text=":"/></TextBlock>
        <TextBox x:Name="txtbox_nit_Copy" HorizontalAlignment="Left" TextWrapping="Wrap"  VerticalContentAlignment="Center" VerticalAlignment="Top" Width="208" Height="33" FontFamily="Arial Rounded MT Bold" FontSize="16" Margin="132,63,0,0" Grid.RowSpan="2"/>
        <Border BorderBrush="Black" BorderThickness="0.5" Grid.ColumnSpan="2" Margin="10,6,10,75" Grid.RowSpan="2" Grid.Row="2"/>
        <TextBlock  Background="White" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center"  Height="33"  Width="148" FontFamily="Arial" FontSize="18" Margin="27,0,0,0"><Run Language="es-gt" Text="Detalle del Cliente"/></TextBlock>
        <TextBlock  Background="White" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top"  Height="19"  Width="163" FontFamily="Arial" FontSize="18" Margin="27,71,0,0" Grid.RowSpan="2" Grid.Row="1"><Run Text="Detalle del "/><Run Language="es-gt" Text="Producto"/></TextBlock>
        <Button Content="Imprimir" HorizontalAlignment="Left"  Grid.Row="7" VerticalAlignment="Center" Width="144" Height="42" Foreground="#FF0C0C0C" FontSize="16" FontWeight="Bold" BorderBrush="Black" Click="button_print" Margin="278,0,0,0" Grid.ColumnSpan="2">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF00DAFF"/>
                    <GradientStop Color="#FF1DB7D1" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>

    </Grid>

</Window>
