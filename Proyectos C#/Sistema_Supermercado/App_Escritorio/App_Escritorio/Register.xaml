<Window x:Class="App_Escritorio.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Escritorio"
        mc:Ignorable="d"
        Title="Registrar Usuario" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFA8EFFF" Offset="0.63"/>
                <GradientStop Color="#FF5FD695" Offset="1"/>
                <GradientStop Color="#FF5FD695"/>
                <GradientStop Color="White"/>
                <GradientStop Color="#FFF7F7F7" Offset="0.309"/>
                <GradientStop Color="#FFF0F0F0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="Nombre" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalContentAlignment="Left" FontSize="18" FontFamily="Bell MT" Background="{x:Null}" FontWeight="Bold" Width="184" Foreground="#FB000000"/>
        <Label Content="Usuario" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center" HorizontalContentAlignment="Left" FontSize="18" FontFamily="Bell MT" Background="{x:Null}" Foreground="#FB000000" FontWeight="Bold" Width="184"/>
        <Label Content="Contrasena" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" HorizontalContentAlignment="Left" FontSize="18" FontFamily="Bell MT" Background="{x:Null}" Foreground="#FB000000" FontWeight="Bold" Width="184"/>
        <Label Content="Confirmar Contrasena" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Center" HorizontalContentAlignment="Right" FontSize="18" FontFamily="Bell MT" Background="{x:Null}" Foreground="#FB000000" FontWeight="Bold"/>
        <TextBox x:Name="txt_name" Grid.Column="1" VerticalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="266" Height="30" BorderBrush="#FF0032C9"/>
        <TextBox x:Name="txt_username" Grid.Column="1" VerticalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Height="30" Margin="0,10,0,0" BorderBrush="#FF0032C9"/>
        <Button Content="Registrar" HorizontalAlignment="Center" Grid.Row="5" VerticalAlignment="Center" Width="92" Background="#FF00ED28" Foreground="White" FontFamily="Arial Rounded MT Bold" FontSize="14" Height="41" Click="Button_Registrar"/>

        <PasswordBox x:Name="txt_password" Grid.Column="1" VerticalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="4" VerticalAlignment="Center" Width="266" Height="33" BorderBrush="#FF0032C9"/>
        <PasswordBox x:Name="txt_confirm_password" Grid.Column="1" VerticalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Width="266" Height="33" BorderBrush="#FF0032C9"/>
        <Button Content="Login" HorizontalAlignment="Center" Grid.Row="5" VerticalAlignment="Center" Width="92" Background="#FF004AED" Foreground="White" FontFamily="Arial Rounded MT Bold" FontSize="14" Height="41" Click="Button_Login" Grid.Column="1"/>


    </Grid>
</Window>
